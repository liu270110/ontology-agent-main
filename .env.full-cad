# ============================================================================
# ontology-agent 配置档模板 —— full-cad 档（full 全量 + CAD 出图/FreeCAD 外置服务）
# 依据：docs/ops/04 §4 + docs/standards/03 §3 初始化配置矩阵 v1（图纸·写=cad.render/
# 模板库/规则包，装配键 OA_CAD_SERVICE_URL 属 full-cad 档）。
# ⚠ 统一配置层现状：deploy_profile 枚举仅 lite|full（services/platform/config.py），
#   故本档 OA_DEPLOY_PROFILE 填 full；CAD 通道为外置服务 URL，经连接器/MCP 装配生效，
#   OA_CAD_SERVICE_URL 尚未接线统一配置层（接线随批次 B/C），下方以注释预留勿当生效。
# 其余与 .env.full 一致（GPU 模型/TEI 嵌入/docling 解析）。
# ============================================================================

# ── 部署档位（枚举限 lite|full；full-cad 差异=外置 CAD 通道，不在本键表达）──
OA_DEPLOY_PROFILE=full

# ── 数据层（同 full 档五存储口径）──
OA_PG_HOST=localhost
OA_PG_PORT=5432
OA_PG_USER=onto
# 【改我】生产必改
OA_PG_PASSWORD=onto_dev
OA_PG_DB=onto
OA_REDIS_URL=redis://localhost:6379/0
OA_MINIO_ENDPOINT=localhost:9000
OA_MINIO_USER=onto
# 【改我】生产必改
OA_MINIO_PASSWORD=onto_dev

# ── 安全 ──
# 【改我】生产必改
OA_JWT_SECRET=dev-only-change-me
# 【改我】上架技能市场前必配（生成命令见 .env.lite 同项）
# OA_PLATFORM_PLUGIN_SIGNING_KEY=

# ── 模型渠道（同 full 档：本地 vLLM 主力，端口 18001=本机避让约定）──
OA_LLM_BASE_URL=http://127.0.0.1:18001/v1
OA_LLM_MODEL=local-main
# 【改我】反代/云渠道必填
# OA_LLM_API_KEY=
# 云渠道溢出/兜底：
# OA_LLM_BASE_URL=https://api.deepseek.com
# OA_LLM_MODEL=deepseek-chat
# OA_LLM_TIMEOUT_S=60

# ── 嵌入端点（同 full 档：TEI@18002 默认）──
OA_OLLAMA_BASE_URL=http://127.0.0.1:18002
OA_EMBED_PROTOCOL=tei

# ── 能力层（同 full 档安全默认）──
# 【改我】启用 agent 文件能力时指向专用目录
# OA_WORKSPACE_ROOT=./data/workspace
# 【改我】生产必配（空=web 工具全拒 fail-closed）
# OA_WEB_EGRESS_ALLOWLIST=
# OA_TASK_WORKER_ENABLED=true

# ── 知识库解析（同 full 档：docling，缺库自动降级 pdfium）──
OA_KB_PARSER=docling

# ── 图纸通道（standards/03 §3 矩阵外置件——尚未接线统一配置层，注释预留勿当生效）──
# OA_CAD_SERVICE_URL=     # cad.render 外置 CAD 服务（full-cad 装配键，接线随批次 B/C）
# OA_OCR_ENDPOINT=        # ocr.run 外置 OCR 服务
# OA_VLM_ENDPOINT=        # vision.analyze 外置 VLM 服务

# ── 技能目录注入（默认已指向 services/skills）──
# OA_SKILLS_CATALOG_DIR=services/skills
