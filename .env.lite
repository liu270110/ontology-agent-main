# ============================================================================
# ontology-agent 配置档模板 —— lite 档（零 GPU：CPU 文本层 + 确定性出图）
# 依据：docs/ops/04 §4（三档模板）+ docs/standards/03 §3 初始化配置矩阵 v1
# 用法：复制为仓库根 .env（install.sh/ps1 第 6 步可交互合成）；【改我】= 生产必改项
# 纪律：本模板只含既有 OA_* 键（唯一取配置入口=services/platform/config.py）；
#       矩阵中尚未接线统一配置层的键（OA_OCR_ENDPOINT/OA_VLM_*/OA_CAD_SERVICE_URL/
#       OA_BROWSER_MCP_URL/OA_FRONTEND_DIST 等）一律以注释预留，不作为生效配置。
# 优先级：config.py 默认值 → OA_* 环境变量 → 本文件(.env)
# ============================================================================

# ── 部署档位（config.py deploy_profile；枚举仅 lite|full——full-cad 档也填 full，
#    CAD 出图等差异为外置服务通道，经连接器/MCP 装配，见 standards/03 §3 矩阵）──
OA_DEPLOY_PROFILE=lite

# ── 数据层（存储栈三件；与 deploy/docker-compose.yml 的 compose 变量同名对齐）──
OA_PG_HOST=localhost
OA_PG_PORT=5432
OA_PG_USER=onto
# 【改我】生产必改（默认与 compose 开发默认一致）
OA_PG_PASSWORD=onto_dev
OA_PG_DB=onto
OA_REDIS_URL=redis://localhost:6379/0
OA_MINIO_ENDPOINT=localhost:9000
OA_MINIO_USER=onto
# 【改我】生产必改
OA_MINIO_PASSWORD=onto_dev

# ── 安全（M1 起；生产必改，密钥绝不入库——架构 07 §6）──
# 【改我】JWT 签名密钥（dev-only-change-me 仅限本机开发）
OA_JWT_SECRET=dev-only-change-me
# 平台插件签名私钥（Skills §5.1，Ed25519 seed hex；缺失=发布/安装 fail-closed）
# 生成：python -c "from services.platform.security import generate_signing_key; print(generate_signing_key())"
# 【改我】上架技能市场前必配
# OA_PLATFORM_PLUGIN_SIGNING_KEY=

# ── 模型渠道（14 篇 §9：OpenAI 兼容端点；lite 推荐云渠道起步，零 GPU）──
# 云渠道（DeepSeek）：
OA_LLM_BASE_URL=https://api.deepseek.com
# 【改我】云渠道必填令牌（云渠道密钥形制，绝不入库、绝不进日志）
# OA_LLM_API_KEY=
OA_LLM_MODEL=deepseek-chat
# 本地 vLLM 渠道（GPU 栈起服后切换，docker/docker-compose.gpu.yml；端口 18001=本机避让约定）
# OA_LLM_BASE_URL=http://127.0.0.1:18001/v1
# OA_LLM_MODEL=local-main
# 模型端口超时秒（[10,600]；首晋门4 教训 Settings 化，standards/03 §5）
# OA_LLM_TIMEOUT_S=60

# ── 嵌入端点（协议 ollama|tei；lite 零 GPU 可暂不部署——嵌入不可用自动降级）──
OA_OLLAMA_BASE_URL=http://localhost:11434
OA_EMBED_PROTOCOL=ollama
# TEI 部署示例（本机 GPU 栈，端口 18002）：
# OA_OLLAMA_BASE_URL=http://127.0.0.1:18002
# OA_EMBED_PROTOCOL=tei

# ── 能力层（standards/03 §3 内核 P0 默认开；写类默认关=W2-4 治理裁决，默认值已安全）──
# fs 工具工作区根（不设=禁用 fs 工具；设了也仅只读三件，写类需显式开 OA_KERNEL_CAPABILITY_WRITE）
# 【改我】启用 agent 文件能力时指向专用目录
# OA_WORKSPACE_ROOT=./data/workspace
# web 出口白名单（逗号分隔域名；空=web 工具全拒 fail-closed）
# OA_WEB_EGRESS_ALLOWLIST=docs.example.com
# 任务执行 worker（False=回到 queued 挂起旧行为；验收靶隔离共库扰动时置 false，standards/03 §5）
# OA_TASK_WORKER_ENABLED=true

# ── 知识库解析（图纸·读：lite=pdfium 确定性文本层，零模型、零下载）──
OA_KB_PARSER=pdfium

# ── 技能目录注入（L1 通道，默认已指向 services/skills；默认全量装载）──
# OA_SKILLS_CATALOG_DIR=services/skills
# OA_SKILLS_CATALOG_INCLUDE=
# OA_SKILLS_CATALOG_EXCLUDE=
