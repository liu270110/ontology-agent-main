# 任务本体 Task Ontology v0.2 — 平台标准本体模块
#
# 定位: docs/研究整理/07 篇 §5.2 的代码化落地, "agent 按 ontology 执行"的前提。
#       不随行业变, 随语义层(semantic/modeling)交付; 与业务本体分命名空间隔离(国标 GB/T 48000.3 第 9 章扩展原则)。
# 归属: 本文件 = 节点层校验(SHACL) + 部分图层校验(sh:sparql 无环/单活跃计划)。
#       图层其余(跨步产消匹配) = SPARQL 图结构约束(规则模板层, 版本化管理);
#       语义层(前置/后置类不相交等) = DL 推理, 规划期低频执行。
# 状态机迁移合法性: 迁移表 = 规则模板层, 本文件只锁状态词表。
# 命名空间: 部署时按管理机构域名替换示例域(国标 IRI 规则)。

@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix task: <https://ontology-agent.example/ontology/task#> .

<https://ontology-agent.example/ontology/task> a owl:Ontology ;
    owl:versionInfo "v0.2" ;
    rdfs:label "任务本体 Task Ontology"@zh ;
    rdfs:comment "Harness Agent 的任务世界模型: Task/Plan/Step/Precondition/Postcondition/SuccessCriterion/Artifact/FailureMode/StateChange/Executor 九类 + 信任级与行动类标注词表。依据 07 篇 v0.2 §5.2 与 _qa 评审记录 P0 修复。"@zh .

# ============================================================
# 1. 枚举词表
# ============================================================

task:ExecutionMode a owl:Class ;
    rdfs:label "行动执行模式"@zh ;
    rdfs:comment "行动类的安全分类学: 门禁强度与审批路由的依据(07 篇 §5.1)。"@zh .

task:modeReadOnly a task:ExecutionMode ; rdfs:label "只读"@zh .
task:modeStateful a task:ExecutionMode ; rdfs:label "有状态写(平台内)"@zh .
task:modeExternalWrite a task:ExecutionMode ; rdfs:label "外部写(业务系统), 强制审批"@zh .
task:modeCode a task:ExecutionMode ; rdfs:label "沙箱代码执行, 出口最严"@zh .

task:TrustLevel a owl:Class ;
    rdfs:label "事实信任级"@zh ;
    rdfs:comment "判据自证防线: SuccessCriterion 只可引用 externallyVerified 事实(07 篇 §5.2/§6.7-1)。"@zh .

task:externallyVerified a task:TrustLevel ; rdfs:label "外部验证(业务回执/回调/双向核对)"@zh .
task:agentAttested a task:TrustLevel ; rdfs:label "代理自证(agent 从工具结果转写)"@zh .

task:StepState a owl:Class ; rdfs:label "步骤状态"@zh .
task:stPlanned a task:StepState ; rdfs:label "已规划"@zh .
task:stGated a task:StepState ; rdfs:label "门禁通过"@zh .
task:stExecuting a task:StepState ; rdfs:label "执行中"@zh .
task:stWaitingApproval a task:StepState ; rdfs:label "待审批"@zh .
task:stValidated a task:StepState ; rdfs:label "已校验"@zh .
task:stFailed a task:StepState ; rdfs:label "失败"@zh .
task:stSuspended a task:StepState ; rdfs:label "挂起"@zh .

task:PlanStatus a owl:Class ; rdfs:label "计划状态"@zh .
task:planActive a task:PlanStatus ; rdfs:label "活跃"@zh .
task:planSuperseded a task:PlanStatus ; rdfs:label "已被取代"@zh .

task:PlanOrigin a owl:Class ; rdfs:label "计划来源"@zh .
task:planFromTemplate a task:PlanOrigin ; rdfs:label "模板匹配"@zh .
task:planFromCombination a task:PlanOrigin ; rdfs:label "行动类内组合"@zh .
task:planFreeform a task:PlanOrigin ; rdfs:label "自由生成(兜底)"@zh .

task:TaskState a owl:Class ; rdfs:label "任务状态"@zh .
task:tPending a task:TaskState ; rdfs:label "待执行"@zh .
task:tRunning a task:TaskState ; rdfs:label "执行中"@zh .
task:tWaitingApproval a task:TaskState ; rdfs:label "待审批"@zh .
task:tSucceeded a task:TaskState ; rdfs:label "已成功"@zh .
task:tFailed a task:TaskState ; rdfs:label "已失败"@zh .
task:tCancelled a task:TaskState ; rdfs:label "已取消"@zh .

task:ActorType a owl:Class ; rdfs:label "变更主体类型"@zh .
task:actorModel a task:ActorType ; rdfs:label "模型决策"@zh .
task:actorRuleEngine a task:ActorType ; rdfs:label "规则执行器"@zh .
task:actorHuman a task:ActorType ; rdfs:label "人工操作"@zh .

task:ExecutorKind a owl:Class ; rdfs:label "执行者种类"@zh .
task:exPlatformLoop a task:ExecutorKind ; rdfs:label "平台循环"@zh .
task:exSubagent a task:ExecutorKind ; rdfs:label "子代理"@zh .
task:exRuleEngine a task:ExecutorKind ; rdfs:label "规则执行器"@zh .
task:exHuman a task:ExecutorKind ; rdfs:label "人工"@zh .
task:exCapabilityPack a task:ExecutorKind ; rdfs:label "能力包"@zh .

# ============================================================
# 2. 类
# ============================================================

task:Task a owl:Class ;
    rdfs:label "任务"@zh ;
    rdfs:comment "任务状态机与预算的锚点; 漂移检测每 N 步从 ABox 重读此对象。"@zh .

task:Plan a owl:Class ;
    rdfs:label "计划"@zh ;
    rdfs:comment "可版本化、可整体校验的行动方案; 重规划后旧计划置 planSuperseded。"@zh .

task:Step a owl:Class ;
    rdfs:label "步骤"@zh ;
    rdfs:comment "规划的单元与并行派发单元; dependsOn 构成 DAG 而非线性序。"@zh .

task:Precondition a owl:Class ;
    rdfs:label "前置条件"@zh ;
    rdfs:comment "事前门禁: SPARQL ASK(打在会话投影上)或 SHACL shape 引用(带版本)。"@zh .

task:Postcondition a owl:Class ;
    rdfs:label "后置条件"@zh ;
    rdfs:comment "事后校验, 结构同前置条件。"@zh .

task:SuccessCriterion a owl:Class ;
    rdfs:label "完成判据"@zh ;
    rdfs:comment "终止谓词——由 harness 求值, 不由模型宣称; 只可引用 externallyVerified 事实。"@zh .

task:Artifact a owl:Class ;
    rdfs:label "产物"@zh ;
    rdfs:comment "步骤产出的本体实例, 带出处指针与信任级(候选非成品底线的落点)。"@zh .

task:FailureMode a owl:Class ;
    rdfs:label "失败模式"@zh ;
    rdfs:comment "重试超限后的补偿路径: 绑定补偿行动类。"@zh .

task:StateChange a owl:Class ;
    rdfs:label "状态变更(审计元类)"@zh ;
    rdfs:comment "任取一条 ABox 变更可归因: 模型/规则/人写的、用哪个能力包版本、哪次决策。"@zh .

task:Executor a owl:Class ;
    rdfs:label "执行者"@zh ;
    rdfs:comment "并行派发与人工接管的执行语义绑定。"@zh .

# ============================================================
# 3. 属性
# ============================================================

# --- Task ---
task:goal a owl:DatatypeProperty ; rdfs:domain task:Task ; rdfs:range xsd:string ;
    rdfs:label "目标"@zh ; rdfs:comment "能力问题(CQ)形式, 建模验收即评测骨架。"@zh .
task:taskState a owl:ObjectProperty ; rdfs:domain task:Task ; rdfs:range task:TaskState ; rdfs:label "任务状态"@zh .
task:maxSteps a owl:DatatypeProperty ; rdfs:domain task:Task ; rdfs:range xsd:integer ; rdfs:label "步数预算"@zh .
task:maxTokens a owl:DatatypeProperty ; rdfs:domain task:Task ; rdfs:range xsd:integer ; rdfs:label "token 预算"@zh .
task:deadline a owl:DatatypeProperty ; rdfs:domain task:Task ; rdfs:range xsd:dateTime ;
    rdfs:label "期限"@zh ; rdfs:comment "判据含 SLA 就必须有期限属性(评审 P1 修复)。"@zh .
task:hasPlan a owl:ObjectProperty ; rdfs:domain task:Task ; rdfs:range task:Plan ; rdfs:label "拥有计划"@zh .
task:criterion a owl:ObjectProperty ; rdfs:domain task:Task ; rdfs:range task:SuccessCriterion ; rdfs:label "完成判据"@zh .

# --- Plan ---
task:planStatus a owl:ObjectProperty ; rdfs:domain task:Plan ; rdfs:range task:PlanStatus ; rdfs:label "计划状态"@zh .
task:planOrigin a owl:ObjectProperty ; rdfs:domain task:Plan ; rdfs:range task:PlanOrigin ; rdfs:label "计划来源"@zh .
task:hasStep a owl:ObjectProperty ; rdfs:domain task:Plan ; rdfs:range task:Step ; rdfs:label "包含步骤"@zh .
task:supersedes a owl:ObjectProperty ; rdfs:domain task:Plan ; rdfs:range task:Plan ; rdfs:label "取代"@zh .
task:derivedFromTemplate a owl:ObjectProperty ;
    rdfs:label "源自计划模板"@zh ; rdfs:comment "模板匹配档必填(模板库 = 已验证计划的固化复用)。"@zh .

# --- Step ---
task:dependsOn a owl:ObjectProperty ; rdfs:domain task:Step ; rdfs:range task:Step ;
    rdfs:label "依赖"@zh ; rdfs:comment "必须构成 DAG; 无环由本文件 SPARQL 约束保证。"@zh .
task:boundActionClass a owl:ObjectProperty ;
    rdfs:domain task:Step ; rdfs:range owl:Thing ;
    rdfs:label "绑定行动类"@zh ;
    rdfs:comment "指向业务本体行动类; 行动类先行, 工具是实现绑定。"@zh .
task:hasInput a owl:ObjectProperty ; rdfs:domain task:Step ; rdfs:range task:Artifact ; rdfs:label "输入产物"@zh .
task:hasOutput a owl:ObjectProperty ; rdfs:domain task:Step ; rdfs:range task:Artifact ; rdfs:label "输出产物"@zh .
task:stepState a owl:ObjectProperty ; rdfs:domain task:Step ; rdfs:range task:StepState ; rdfs:label "步骤状态"@zh .
task:stepOrder a owl:DatatypeProperty ; rdfs:domain task:Step ; rdfs:range xsd:integer ; rdfs:label "展示序"@zh .
task:precondition a owl:ObjectProperty ; rdfs:domain task:Step ; rdfs:range task:Precondition ; rdfs:label "前置条件"@zh .
task:postcondition a owl:ObjectProperty ; rdfs:domain task:Step ; rdfs:range task:Postcondition ; rdfs:label "后置条件"@zh .
task:executor a owl:ObjectProperty ; rdfs:domain task:Step ; rdfs:range task:Executor ; rdfs:label "执行者"@zh .
task:hasFailureMode a owl:ObjectProperty ; rdfs:domain task:Step ; rdfs:range task:FailureMode ; rdfs:label "失败模式"@zh .

# --- 条件与判据 ---
task:askQuery a owl:DatatypeProperty ;
    rdfs:domain task:Precondition ;
    rdfs:range xsd:string ;
    rdfs:comment "SPARQL ASK 文本; 求值载体 = 会话内任务级 RDF 投影(07 篇 §6.2-3)。"@zh .
task:shapeRef a owl:ObjectProperty ; rdfs:label "shape 引用"@zh ; rdfs:comment "指向 SHACL shape 资源。"@zh .
task:shapeVersion a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "shape 版本"@zh ; rdfs:comment "与 shapeRef 成对, 本体升级可迁移(评审 P1 修复)。"@zh .
task:criterionQuery a owl:DatatypeProperty ; rdfs:domain task:SuccessCriterion ; rdfs:range xsd:string ;
    rdfs:label "判据查询"@zh ; rdfs:comment "SPARQL ASK; 文本层白名单复检在运行期执行(README §5)。"@zh .
task:citesFact a owl:ObjectProperty ; rdfs:domain task:SuccessCriterion ; rdfs:range task:Artifact ;
    rdfs:label "引用事实"@zh ; rdfs:comment "每个被引用事实必须为 externallyVerified(SHACL 强制)。"@zh .

# --- Artifact / 信任级 ---
task:trustLevel a owl:ObjectProperty ; rdfs:domain task:Artifact ; rdfs:range task:TrustLevel ; rdfs:label "信任级"@zh .
task:artifactOf a owl:ObjectProperty ; rdfs:domain task:Artifact ;
    rdfs:label "产物本体实例"@zh ; rdfs:comment "指向业务本体实例 IRI。"@zh .
task:provenanceDoc a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "出处-文档 ID"@zh .
task:provenanceChunk a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "出处-分片 ID"@zh .
task:provenanceSpan a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "出处-跨度"@zh .

# --- FailureMode ---
task:failureType a owl:DatatypeProperty ; rdfs:domain task:FailureMode ; rdfs:range xsd:string ; rdfs:label "失败类型"@zh .
task:retryCount a owl:DatatypeProperty ; rdfs:domain task:FailureMode ; rdfs:range xsd:integer ; rdfs:label "重试计数"@zh .
task:compensationAction a owl:ObjectProperty ;
    rdfs:domain task:FailureMode ;
    rdfs:label "补偿行动类"@zh ; rdfs:comment "重试超限后的回滚路径(评审 P1 修复)。"@zh .

# --- StateChange (审计元类) ---
task:about a owl:ObjectProperty ; rdfs:domain task:StateChange ; rdfs:label "变更对象"@zh .
task:actorType a owl:ObjectProperty ; rdfs:domain task:StateChange ; rdfs:range task:ActorType ; rdfs:label "主体类型"@zh .
task:actorId a owl:DatatypeProperty ; rdfs:domain task:StateChange ; rdfs:range xsd:string ; rdfs:label "主体 ID"@zh .
task:decisionId a owl:DatatypeProperty ; rdfs:domain task:StateChange ; rdfs:range xsd:string ;
    rdfs:label "决策 ID"@zh ; rdfs:comment "关联 trace/决策记录。"@zh .
task:capabilityVersion a owl:DatatypeProperty ; rdfs:domain task:StateChange ; rdfs:range xsd:string ;
    rdfs:label "能力包版本"@zh ; rdfs:comment "能力包产生变更时必填(评审提问 9: 任取三元组可归因)。"@zh .
task:changedAt a owl:DatatypeProperty ; rdfs:domain task:StateChange ; rdfs:range xsd:dateTime ; rdfs:label "变更时间"@zh .

# --- Executor ---
task:executorKind a owl:ObjectProperty ; rdfs:domain task:Executor ; rdfs:range task:ExecutorKind ; rdfs:label "执行者种类"@zh .
task:boundCapability a owl:DatatypeProperty ; rdfs:domain task:Executor ; rdfs:range xsd:string ;
    rdfs:label "绑定能力"@zh ; rdfs:comment "能力包 IRI@版本; exCapabilityPack 时必填。"@zh .

# --- 行动类标注(业务本体侧使用, 由 ActionClassShape 强制) ---
task:executionMode a owl:ObjectProperty ; rdfs:range task:ExecutionMode ;
    rdfs:label "执行模式"@zh ; rdfs:comment "行动类的安全分类学属性。"@zh .
task:deterministic a owl:DatatypeProperty ; rdfs:range xsd:boolean ;
    rdfs:label "确定性标注"@zh ; rdfs:comment "步级推理分级路由的判定依据(07 篇 §6.2-5)。"@zh .

# ============================================================
# 4. SHACL Shapes (节点层 + 部分图层校验)
# ============================================================

# --- Task ---
task:TaskShape a sh:NodeShape ;
    sh:targetClass task:Task ;
    rdfs:label "任务约束"@zh ;
    sh:property [
        sh:path task:goal ; sh:minCount 1 ; sh:datatype xsd:string ;
        sh:name "目标必填"@zh ;
    ] ;
    sh:property [
        sh:path task:criterion ; sh:minCount 1 ;
        sh:name "每个任务必须有完成判据"@zh ;
    ] ;
    sh:property [
        sh:path task:hasPlan ; sh:minCount 1 ;
        sh:name "每个任务必须有计划"@zh ;
    ] ;
    sh:property [
        sh:path task:maxSteps ; sh:datatype xsd:integer ; sh:minInclusive 1 ;
        sh:name "步数预算为正整数"@zh ;
    ] ;
    sh:property [
        sh:path task:deadline ; sh:datatype xsd:dateTime ;
        sh:name "期限为 dateTime(可选)"@zh ;
    ] ;
    sh:property [
        sh:path task:taskState ; sh:minCount 1 ;
        sh:in ( task:tPending task:tRunning task:tWaitingApproval task:tSucceeded task:tFailed task:tCancelled ) ;
        sh:name "任务状态词表封闭"@zh ;
    ] .

task:TaskSingleActivePlanShape a sh:NodeShape ;
    sh:targetClass task:Task ;
    rdfs:label "每任务至多一个活跃计划"@zh ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Task 同时存在多个 active 状态的 Plan" ;
        sh:select """
            PREFIX task: <https://ontology-agent.example/ontology/task#>
            SELECT $this WHERE {
                $this task:hasPlan ?p1 , ?p2 .
                ?p1 task:planStatus task:planActive .
                ?p2 task:planStatus task:planActive .
                FILTER ( STR(?p1) < STR(?p2) )
            }""" ;
    ] .

# --- Plan ---
task:PlanShape a sh:NodeShape ;
    sh:targetClass task:Plan ;
    rdfs:label "计划约束"@zh ;
    sh:property [
        sh:path task:planStatus ; sh:minCount 1 ;
        sh:in ( task:planActive task:planSuperseded ) ;
        sh:name "计划状态词表封闭"@zh ;
    ] ;
    sh:property [
        sh:path task:planOrigin ; sh:minCount 1 ;
        sh:in ( task:planFromTemplate task:planFromCombination task:planFreeform ) ;
        sh:name "计划来源三档"@zh ;
    ] ;
    sh:property [
        sh:path task:hasStep ; sh:minCount 1 ;
        sh:name "计划至少包含一个步骤"@zh ;
    ] .

task:PlanTemplateOriginShape a sh:NodeShape ;
    sh:targetClass task:Plan ;
    rdfs:label "模板来源必留痕"@zh ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "planOrigin 为模板匹配时必须提供 derivedFromTemplate" ;
        sh:select """
            PREFIX task: <https://ontology-agent.example/ontology/task#>
            SELECT $this WHERE {
                $this task:planOrigin task:planFromTemplate .
                FILTER NOT EXISTS { $this task:derivedFromTemplate ?t }
            }""" ;
    ] .

# --- Step ---
task:StepShape a sh:NodeShape ;
    sh:targetClass task:Step ;
    rdfs:label "步骤约束"@zh ;
    sh:property [
        sh:path task:boundActionClass ; sh:minCount 1 ; sh:nodeKind sh:IRI ;
        sh:name "步骤必须绑定行动类"@zh ;
    ] ;
    sh:property [
        sh:path task:stepState ; sh:minCount 1 ;
        sh:in ( task:stPlanned task:stGated task:stExecuting task:stWaitingApproval task:stValidated task:stFailed task:stSuspended ) ;
        sh:name "步骤状态词表封闭"@zh ;
    ] ;
    sh:property [
        sh:path task:stepOrder ; sh:datatype xsd:integer ;
        sh:name "展示序为整数(可选)"@zh ;
    ] .

task:StepAcyclicShape a sh:NodeShape ;
    sh:targetClass task:Step ;
    rdfs:label "依赖无环(DAG)"@zh ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Step 的 dependsOn 关系存在环" ;
        sh:select """
            PREFIX task: <https://ontology-agent.example/ontology/task#>
            SELECT $this WHERE {
                $this task:dependsOn+ $this .
            }""" ;
    ] .

# 行动类约束: 任何被 Step 绑定的行动类必须有唯一执行模式与确定性标注
task:ActionClassShape a sh:NodeShape ;
    sh:targetObjectsOf task:boundActionClass ;
    rdfs:label "行动类标注约束"@zh ;
    sh:property [
        sh:path task:executionMode ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( task:modeReadOnly task:modeStateful task:modeExternalWrite task:modeCode ) ;
        sh:name "行动类必须带唯一执行模式"@zh ;
    ] ;
    sh:property [
        sh:path task:deterministic ; sh:minCount 1 ; sh:datatype xsd:boolean ;
        sh:name "行动类必须带确定性标注(路由依据)"@zh ;
    ] .

# --- 条件(前置/后置共用结构) ---
task:ConditionShape a sh:NodeShape ;
    sh:targetClass task:Precondition , task:Postcondition ;
    rdfs:label "条件表达约束: ASK 查询或带版本的 shape 引用, 至少其一"@zh ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "条件既无 askQuery 也无 shapeRef+shapeVersion" ;
        sh:select """
            PREFIX task: <https://ontology-agent.example/ontology/task#>
            SELECT $this WHERE {
                FILTER NOT EXISTS { $this task:askQuery ?q }
                FILTER NOT EXISTS {
                    $this task:shapeRef ?s ; task:shapeVersion ?v .
                }
            }""" ;
    ] .

# --- SuccessCriterion: 信任级强制(判据自证防线的结构层) ---
task:SuccessCriterionShape a sh:NodeShape ;
    sh:targetClass task:SuccessCriterion ;
    rdfs:label "完成判据约束"@zh ;
    sh:property [
        sh:path task:criterionQuery ; sh:minCount 1 ; sh:datatype xsd:string ;
        sh:name "判据查询必填"@zh ;
    ] ;
    sh:property [
        sh:path task:citesFact ; sh:minCount 1 ; sh:node task:TrustedFactShape ;
        sh:name "判据引用的每个事实必须为 externallyVerified"@zh ;
    ] .

task:TrustedFactShape a sh:NodeShape ;
    rdfs:label "可信事实形态"@zh ;
    sh:property [
        sh:path task:trustLevel ; sh:minCount 1 ; sh:hasValue task:externallyVerified ;
        sh:name "信任级必须是 externallyVerified"@zh ;
    ] .

# --- Artifact ---
task:ArtifactShape a sh:NodeShape ;
    sh:targetClass task:Artifact ;
    rdfs:label "产物约束"@zh ;
    sh:property [
        sh:path task:trustLevel ; sh:minCount 1 ;
        sh:in ( task:externallyVerified task:agentAttested ) ;
        sh:name "产物必须带信任级"@zh ;
    ] ;
    sh:property [
        sh:path task:provenanceDoc ; sh:minCount 1 ; sh:datatype xsd:string ;
        sh:name "产物必须带出处指针(候选非成品底线)"@zh ;
    ] .

# --- StateChange (审计) ---
task:StateChangeShape a sh:NodeShape ;
    sh:targetClass task:StateChange ;
    rdfs:label "状态变更归因约束"@zh ;
    sh:property [
        sh:path task:about ; sh:minCount 1 ; sh:nodeKind sh:IRI ;
        sh:name "变更对象必填"@zh ;
    ] ;
    sh:property [
        sh:path task:actorType ; sh:minCount 1 ;
        sh:in ( task:actorModel task:actorRuleEngine task:actorHuman ) ;
        sh:name "主体类型三分类"@zh ;
    ] ;
    sh:property [
        sh:path task:actorId ; sh:minCount 1 ; sh:datatype xsd:string ;
        sh:name "主体 ID 必填"@zh ;
    ] ;
    sh:property [
        sh:path task:changedAt ; sh:minCount 1 ; sh:datatype xsd:dateTime ;
        sh:name "变更时间必填"@zh ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "能力包产生的变更必须带 capabilityVersion" ;
        sh:select """
            PREFIX task: <https://ontology-agent.example/ontology/task#>
            SELECT $this WHERE {
                $this task:capabilityVersion ?v .
                FILTER ( STRLEN(STR(?v)) = 0 )
            }""" ;
    ] .

# --- FailureMode ---
task:FailureModeShape a sh:NodeShape ;
    sh:targetClass task:FailureMode ;
    rdfs:label "失败模式约束"@zh ;
    sh:property [
        sh:path task:retryCount ; sh:datatype xsd:integer ; sh:minInclusive 0 ;
        sh:name "重试计数非负整数"@zh ;
    ] ;
    sh:property [
        sh:path task:compensationAction ; sh:minCount 1 ; sh:nodeKind sh:IRI ;
        sh:name "必须绑定补偿行动类"@zh ;
    ] .

# --- Executor ---
task:ExecutorShape a sh:NodeShape ;
    sh:targetClass task:Executor ;
    rdfs:label "执行者约束"@zh ;
    sh:property [
        sh:path task:executorKind ; sh:minCount 1 ;
        sh:in ( task:exPlatformLoop task:exSubagent task:exRuleEngine task:exHuman task:exCapabilityPack ) ;
        sh:name "执行者种类词表封闭"@zh ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "能力包执行者必须绑定 capability IRI@版本" ;
        sh:select """
            PREFIX task: <https://ontology-agent.example/ontology/task#>
            SELECT $this WHERE {
                $this task:executorKind task:exCapabilityPack .
                FILTER NOT EXISTS { $this task:boundCapability ?c }
            }""" ;
    ] .
