# ============================================================================
# ontology-agent 配置档模板 —— full 档（+OCR+VLM，GPU；全量五存储，无降级）
# 依据：docs/ops/04 §4 + docs/standards/03 §3 初始化配置矩阵 v1；GPU 栈部署=docs/ops/03
# 与 .env.lite 的差异：模型/嵌入切本地 GPU 渠道 + 解析引擎切 docling（重模型）。
# 纪律同 lite：只含既有 OA_* 键；【改我】= 生产必改项。
# ============================================================================

# ── 部署档位（config.py 枚举仅 lite|full；full-cad 见 .env.full-cad，同为 full）──
OA_DEPLOY_PROFILE=full

# ── 数据层（full 档五存储：PG+Neo4j+Milvus+MinIO+Redis；Neo4j/Milvus 容器随批次补齐，
#    现经 deploy/README 表格口径——先以 PG 递归 CTE / pgvector 顶配运行）──
OA_PG_HOST=localhost
OA_PG_PORT=5432
OA_PG_USER=onto
# 【改我】生产必改
OA_PG_PASSWORD=onto_dev
OA_PG_DB=onto
OA_REDIS_URL=redis://localhost:6379/0
OA_MINIO_ENDPOINT=localhost:9000
OA_MINIO_USER=onto
# 【改我】生产必改
OA_MINIO_PASSWORD=onto_dev

# ── 安全 ──
# 【改我】生产必改
OA_JWT_SECRET=dev-only-change-me
# 【改我】上架技能市场前必配（生成命令见 .env.lite 同项）
# OA_PLATFORM_PLUGIN_SIGNING_KEY=

# ── 模型渠道（full 档默认本地 vLLM，GPU 推理；端口 18001/18002=本机避让约定，deploy/up.sh --gpu）──
OA_LLM_BASE_URL=http://127.0.0.1:18001/v1
OA_LLM_MODEL=local-main
# 【改我】本地 vLLM 无鉴权时留空；反代/云渠道必填
# OA_LLM_API_KEY=
# 云渠道溢出/兜底（DeepSeek，OpenAI 兼容；14 篇 §9）：
# OA_LLM_BASE_URL=https://api.deepseek.com
# OA_LLM_MODEL=deepseek-chat
# OA_LLM_API_KEY=
# 模型端口超时秒（[10,600]；长上下文首字慢时可调大，standards/03 §5 遗留登记）
# OA_LLM_TIMEOUT_S=60
# 模型韧性（M4.5-C；缺省零行为变化：单凭证直驱、无降级链）——多渠道溢出时配置：
# OA_LLM_FALLBACK_CHAINS=main->backup

# ── 嵌入端点（full 档默认 TEI@18002（bge-m3，GPU）；ollama 通道备选）──
OA_OLLAMA_BASE_URL=http://127.0.0.1:18002
OA_EMBED_PROTOCOL=tei
# ollama 通道（CPU/单机）：
# OA_OLLAMA_BASE_URL=http://localhost:11434
# OA_EMBED_PROTOCOL=ollama

# ── 能力层（同 lite 安全默认；full 档建议显式圈定工作区与出口白名单）──
# 【改我】启用 agent 文件能力时指向专用目录
# OA_WORKSPACE_ROOT=./data/workspace
# 【改我】full 档生产必配（空=web 工具全拒 fail-closed，属安全边界非故障）
# OA_WEB_EGRESS_ALLOWLIST=
# OA_TASK_WORKER_ENABLED=true

# ── 知识库解析（图纸·读：full=docling 重模型引擎，OCR/版面理解；
#    docling 为可选依赖不进主依赖——缺库自动降级 pdfium 并登记 degraded，首次模型下载
#    一次性成本，国内镜像 HF_ENDPOINT=https://hf-mirror.com）──
OA_KB_PARSER=docling

# ── 图纸·读高级通道（standards/03 §3 矩阵外置件——尚未接线统一配置层，注释预留勿当生效）──
# OA_OCR_ENDPOINT=        # ocr.run 外置 OCR 服务（接线随批次 B/C）
# OA_VLM_ENDPOINT=        # vision.analyze 外置 VLM 服务

# ── 技能目录注入（默认已指向 services/skills）──
# OA_SKILLS_CATALOG_DIR=services/skills
