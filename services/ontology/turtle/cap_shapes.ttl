# 平台能力本体 SHACL shapes v1 — ONT-2 批（06 篇 §ONT-2.1 + docs/ontology/03 §2.1）。
#
# AtomicCapabilityShape（门禁语义）：
#   - cap:requires / cap:produces 各≥1、cap:constrainedBy 为合法 IRI 引用 —— Violation 级
#     （不过即拒绝：种子迁移装载 cap.ttl 时 fail-closed）；
#   - 执行语义四元齐备（executionMode/deterministic/triggeredByEvent/guardedByRule）—— warn 级
#     （工具能力无触发事件/守卫规则是常态，缺四元只告警不拒，契约口径）。
# 16 工具参数形状：sh:path 用 cap:arg-* 词表（cap.ttl 声明），minCount 1 的必需参数集与
#   代码 schema 常量对账（tests/ontology/test_ont2_tbox.py）——形状文件是参数约束的结构化
#   登记处（第一公理：一切决定可达性的项结构化入本体），非第二事实源。
# 本文件与 cap.ttl 同目录（契约「SHACL shapes 同目录」），不经版本化发布（平台内建资产，
#   mem.ttl 同款），随平台版本只读。

@prefix cap:  <http://ontology-agent.local/cap#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ============ 门禁 shape（原子能力结构性最低线） ============

cap:AtomicCapabilityShape a sh:NodeShape ;
    sh:targetClass cap:AtomicCapability ;
    rdfs:label "原子能力门禁"@zh ;
    sh:property [
        sh:path cap:requires ;
        sh:minCount 1 ;
        sh:message "原子能力必须有至少一个前置签名（域签名，06 篇 §ONT-2.1）"@zh ;
    ] ;
    sh:property [
        sh:path cap:produces ;
        sh:minCount 1 ;
        sh:message "原子能力必须有至少一个效果签名（值域签名）"@zh ;
    ] ;
    sh:property [
        sh:path cap:constrainedBy ;
        sh:nodeKind sh:IRI ;
        sh:message "constrainedBy 必须为合法 shape IRI 引用"@zh ;
    ] ;
    sh:property [
        sh:path cap:executionMode ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "执行语义四元缺 executionMode（warn）"@zh ;
    ] ;
    sh:property [
        sh:path cap:deterministic ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "执行语义四元缺 deterministic（warn）"@zh ;
    ] ;
    sh:property [
        sh:path cap:triggeredByEvent ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "执行语义四元缺 triggeredByEvent（warn；工具能力常态为空）"@zh ;
    ] ;
    sh:property [
        sh:path cap:guardedByRule ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "执行语义四元缺 guardedByRule（warn；工具能力常态为空）"@zh ;
    ] .

# ============ 16 工具参数形状（minCount 1 = 代码 schema required 集对账锚点） ============

cap:FsReadShape a sh:NodeShape ;
    rdfs:label "fs.read 参数形状"@zh ;
    sh:property [ sh:path cap:arg-path ; sh:minCount 1 ; sh:datatype xsd:string ] .

cap:FsWriteShape a sh:NodeShape ;
    rdfs:label "fs.write 参数形状"@zh ;
    sh:property [ sh:path cap:arg-path ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path cap:arg-content ; sh:minCount 1 ; sh:datatype xsd:string ] .

cap:FsEditShape a sh:NodeShape ;
    rdfs:label "fs.edit 参数形状"@zh ;
    sh:property [ sh:path cap:arg-path ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path cap:arg-old_string ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path cap:arg-new_string ; sh:minCount 1 ; sh:datatype xsd:string ] .

cap:FsGlobShape a sh:NodeShape ;
    rdfs:label "fs.glob 参数形状"@zh ;
    sh:property [ sh:path cap:arg-pattern ; sh:minCount 1 ; sh:datatype xsd:string ] .

cap:FsGrepShape a sh:NodeShape ;
    rdfs:label "fs.grep 参数形状"@zh ;
    sh:property [ sh:path cap:arg-pattern ; sh:minCount 1 ; sh:datatype xsd:string ] .

cap:WebFetchShape a sh:NodeShape ;
    rdfs:label "web.fetch 参数形状"@zh ;
    rdfs:comment "无代码内 schema 常量（fetch 直读 call.parameters），url 必填为运行时语义推导。"@zh ;
    sh:property [ sh:path cap:arg-url ; sh:minCount 1 ; sh:datatype xsd:string ] .

cap:WebSearchShape a sh:NodeShape ;
    rdfs:label "web.search 参数形状"@zh ;
    rdfs:comment "无代码内 schema 常量，query 必填为运行时语义推导。"@zh ;
    sh:property [ sh:path cap:arg-query ; sh:minCount 1 ; sh:datatype xsd:string ] .

cap:TodoWriteShape a sh:NodeShape ;
    rdfs:label "todo.write 参数形状"@zh ;
    sh:property [ sh:path cap:arg-items ; sh:minCount 1 ] .

cap:TodoUpdateShape a sh:NodeShape ;
    rdfs:label "todo.update 参数形状"@zh ;
    sh:property [ sh:path cap:arg-item_id ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path cap:arg-status ; sh:minCount 1 ; sh:datatype xsd:string ] .

cap:TodoReadShape a sh:NodeShape ;
    rdfs:label "todo.read 参数形状"@zh ;
    rdfs:comment "无必需参数（schema required=[]）。"@zh .

cap:ChatAnswerShape a sh:NodeShape ;
    rdfs:label "chat_answer 参数形状"@zh ;
    rdfs:comment "适配器行动非 ToolPort 工具，message 必填为 ChatTurn 语义推导。"@zh ;
    sh:property [ sh:path cap:arg-message ; sh:minCount 1 ; sh:datatype xsd:string ] .

cap:KnowledgeSearchShape a sh:NodeShape ;
    rdfs:label "knowledge.search 参数形状"@zh ;
    sh:property [ sh:path cap:arg-query ; sh:minCount 1 ; sh:datatype xsd:string ] .

cap:OntologyValidateShape a sh:NodeShape ;
    rdfs:label "ontology.validate 参数形状"@zh ;
    sh:property [ sh:path cap:arg-ontology_id ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path cap:arg-graph ; sh:minCount 1 ] .

cap:OntologyQueryShape a sh:NodeShape ;
    rdfs:label "ontology.query 参数形状"@zh ;
    sh:property [ sh:path cap:arg-ontology_id ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path cap:arg-sparql ; sh:minCount 1 ; sh:datatype xsd:string ] .

cap:MemoryInvalidateShape a sh:NodeShape ;
    rdfs:label "memory.invalidate 参数形状"@zh ;
    sh:property [ sh:path cap:arg-fact_id ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path cap:arg-reason ; sh:minCount 1 ; sh:datatype xsd:string ] .

cap:WritebackStatusShape a sh:NodeShape ;
    rdfs:label "writeback.status 参数形状"@zh ;
    rdfs:comment "三键任一（anyOf 语义，R2 算子封闭集外），无单参数必需。"@zh .
