# 开发环境变量（本文件入库作模板；本地差异用 .env.development.local 覆写，后者已入 .gitignore）
#
# VITE_API_MODE —— 数据源语义标注（30 篇 §1 DoD-3：端点接入状态 live/mock）：
#   mock = 经 MSW 仿真（契约=docs/api/01）；live = 真实网关 /api/v1（vite proxy → 8364）。
VITE_API_MODE=live
#
# VITE_ENABLE_MOCK —— MSW worker 启停开关（逻辑见 src/mocks/enable-mock.ts）：
#   2026-10-04 mock 退役（用户指令：后端已开发，UI 不再消费仿真数据）——dev 默认 0 直连真实网关。
#   本地临时回 mock 仿真（如契约联调）：新建 .env.development.local 覆写 VITE_API_MODE=mock + VITE_ENABLE_MOCK=1，勿提交。
#   vitest 契约测试不受此开关影响（node-setup 常开 MSW node server）。
VITE_ENABLE_MOCK=0
