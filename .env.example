# 复制为根目录 .env 使用；.env 已被 .gitignore 覆盖，真实密钥严禁入库（14 篇 §3）
# 优先级：services/infra/config.py 默认值 → OA_* 环境变量 → .env

# ── 模型渠道：云（DeepSeek，OpenAI 兼容；14 篇 §9.4 溢出/兜底渠道）──
OA_LLM_BASE_URL=https://api.deepseek.com
OA_LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
OA_LLM_MODEL=deepseek-flash

# ── 模型渠道：本地 vLLM（docker/docker-compose.gpu.yml 起服后切换）──
# OA_LLM_BASE_URL=http://127.0.0.1:8001/v1
# OA_LLM_MODEL=local-main

# ── 数据层（M0；与 deploy/.env.example 对齐）──
# OA_PG_PASSWORD=onto_dev
# OA_MINIO_PASSWORD=onto_dev

# ── 安全（M1 起）──
# OA_JWT_SECRET=change-me
