  "regulations": [
    {
      "no": "GC-001",
      "name": "配网故障处置调控规程",
      "clauses": [
        {
          "num": "4.2",
          "title": "复电顺序",
          "text": "故障处置遵循“先主干、后分支，先公用、后专用”的复电顺序。"
        },
        {
          "num": "4.5",
          "title": "相位核对",
          "text": "恢复送电前必须核对相序与相位，防止非同相并网。"
        },
        {
          "num": "4.8",
          "title": "强送规定",
          "text": "电缆线路故障跳闸后不得强送，架空线路故障跳闸可试送一次。"
        }
      ]
    },
    {
      "no": "GC-002",
      "name": "电力安全工作规程（线路部分）摘编",
      "clauses": [
        {
          "num": "3.2",
          "title": "停电作业",
          "text": "停电作业应在电源侧装设明显断开点，并悬挂“禁止合闸，有人工作”标示牌。"
        },
        {
          "num": "3.4",
          "title": "验电接地",
          "text": "作业前必须逐相验电，验明无电压后立即装设接地线。"
        }
      ]
    },
    {
      "no": "GC-003",
      "name": "设备巡视缺陷分类标准",
      "clauses": [
        {
          "num": "2.1",
          "title": "危急缺陷",
