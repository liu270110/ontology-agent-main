#!/bin/sh
# wt —— 多 Agent worktree 协作流助手（规范：docs/standards/02-git多Agent协作与Worktree规范.md）
# 用法:
#   wt new <slug> [base]          新建 worktree（../wt-<slug>）+ 分支 feature/<slug>（默认基线 develop）
#   wt list                       列出全部 worktree
#   wt sync                       当前 feature 分支 rebase 到最新 develop
#   wt finish [--push] [--keep]   串行合入 develop（rebase + --no-ff），默认清理 worktree 与分支
#   wt prune                      清理失效 worktree 记录
set -eu

die() { echo "✗ $*" >&2; exit 1; }

main_worktree() { git worktree list --porcelain | sed -n 's/^worktree //p' | head -n 1; }
cur_branch() { git symbolic-ref --quiet --short HEAD 2>/dev/null || echo DETACHED; }
need_feature() {
  _b="$(cur_branch)"
  case "$_b" in feature/*) ;; *) die "须在 feature/* 分支上执行（当前: $_b）";; esac
}

cmd="${1:-}"
[ -n "$cmd" ] || die "用法: wt new|list|sync|finish|prune"

case "$cmd" in
  new)
    slug="${2:-}"; base="${3:-develop}"
    printf '%s' "$slug" | grep -Eq '^[a-z0-9][a-z0-9-]*$' || die "slug 只允许小写字母/数字/连字符，建议含域前缀: wt new <域>-<简述> [base]"
    branch="feature/$slug"
    git show-ref --verify --quiet "refs/heads/$branch" && die "分支已存在: $branch"
    git rev-parse --verify --quiet "$base^{commit}" >/dev/null || die "基线不存在: $base"
    wtpath="$(dirname "$(main_worktree)")/wt-$slug"
    [ -e "$wtpath" ] && die "目录已存在: $wtpath"
    git worktree add -b "$branch" "$wtpath" "$base" >/dev/null || die "创建 worktree 失败"
    echo "✓ worktree: $wtpath"
    echo "✓ 分支:     $branch（基线 $base）"
    echo "下一步: cd \"$wtpath\" 开始工作（提交受 hooks 门禁）；完成后: sh tools/git/wt finish"
    ;;
  list)
    git worktree list
    ;;
  sync)
    need_feature
    git fetch origin develop 2>/dev/null || echo "⚠ fetch 失败（离线?），按本地 develop 对齐"
    base="$(git rev-parse --verify --quiet origin/develop 2>/dev/null || echo develop)"
    echo "rebase $(cur_branch) → $base ..."
    git rebase "$base" || { git rebase --abort; die "rebase 冲突：在本 worktree 解决冲突后 git rebase --continue，再重跑本命令"; }
    echo "✓ 已对齐 $base"
    ;;
  finish)
    # 集成基准 = 本地 develop（v1.1 修正：origin 常落后于本地，rebase 到 origin 会把 develop 独有提交线性化重放，造成假 add/add 冲突）
    integrate_base=develop
    shift
    do_push=0; keep=0
    for a in "$@"; do
      case "$a" in
        --push) do_push=1 ;;
        --keep) keep=1 ;;
        *) die "未知参数: $a（可用: --push --keep）" ;;
      esac
    done
    need_feature
    branch="$(cur_branch)"
    git diff --quiet || die "工作区有未提交修改，先提交"
    git diff --cached --quiet || die "暂存区非空，先提交"
    # ── 串行集成锁：同一时刻只允许一个 agent 合入 develop ──
    main="$(main_worktree)"
    main_git="$(git -C "$main" rev-parse --absolute-git-dir)"
    lock="$main_git/wt-integrate.lock"
    if mkdir "$lock" 2>/dev/null; then
      trap 'rmdir "$lock" 2>/dev/null || true' EXIT INT TERM
    else
      now=$(date +%s); mtime=$(stat -c %Y "$lock" 2>/dev/null || echo "$now")
      age=$(( now - mtime ))
      [ "$age" -gt 600 ] || die "另一 agent 正在合入（锁已持 ${age}s）；稍后重跑 wt finish"
      echo "⚠ 集成锁已持 ${age}s > 600s，判定为残留，接管"
      rm -rf "$lock"; mkdir "$lock"
      trap 'rmdir "$lock" 2>/dev/null || true' EXIT INT TERM
    fi
    # ── 对齐基线 ──
    git fetch origin develop 2>/dev/null || true
    base="$integrate_base"
    git rebase "$base" || { git rebase --abort; die "rebase 冲突：解决后重跑 wt finish"; }
    # ── 主工作区（develop）合入，--no-ff 保留集成痕 ──
    [ "$(git -C "$main" symbolic-ref --quiet --short HEAD)" = "develop" ] || die "主工作区不在 develop 上，请人工检查"
    git -C "$main" diff --cached --quiet || die "主工作区暂存区非空（他人在途），先让持有者提交/清空后再试"
    [ -f "$main_git/MERGE_HEAD" ] && die "主工作区存在未完成合并，请人工处理"
    if ! git -C "$main" merge --no-ff --no-edit -m "chore: merge $branch into develop" "$branch" 2>&1; then
      git -C "$main" merge --abort 2>/dev/null || true
      die "合入冲突（共享文件改动重叠）：请在【本 worktree】wt sync 并解决冲突后重跑 wt finish"
    fi
    echo "✓ 已合入 develop（--no-ff）"
    # ── 清理 ──
    if [ "$keep" = 1 ]; then
      echo "ℹ --keep：保留 worktree 与分支"
    else
      wtpath="$(pwd)"
      cd "$main"
      git worktree remove "$wtpath"
      git branch -d "$branch"
      echo "✓ 已清理 worktree 与分支 $branch"
    fi
    if [ "$do_push" = 1 ]; then
      git push origin develop && echo "✓ 已推送 origin/develop"
    else
      echo "ℹ 未推送（加 --push 推送 origin/develop）"
    fi
    echo "✓ finish 完成"
    ;;
  prune)
    git worktree prune && echo "✓ 已清理失效 worktree 记录"
    ;;
  *)
    die "未知子命令: $cmd（可用: new|list|sync|finish|prune）"
    ;;
esac
